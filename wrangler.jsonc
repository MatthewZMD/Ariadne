{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ariadne-game",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
